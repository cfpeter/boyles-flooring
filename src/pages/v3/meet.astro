---
import V3Layout from '../../layouts/V3Layout.astro';
import FeatureVideo from '../../components/FeatureVideo.astro';
import VideoReels from '../../components/VideoReels.astro';
import { site } from '../../data/site';
import { owner, featuredReel, otherReels } from '../../data/reels';

const lead = featuredReel();
const rest = otherReels();
---

<V3Layout title="The Owner" description="Meet the owner of Boyles Flooring, Santa Clarita.">
  <section class="c-section border-b border-edge">
    <div class="c-wrap grid gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <div class="c-rise" style="--reels-radius:0px">
          <FeatureVideo reel={lead} />
        </div>
        <p class="c-kicker c-rise mt-5 !text-ash">{lead.caption}</p>
      </div>

      <div class="flex flex-col justify-center lg:col-span-7">
        <p class="c-kicker c-rise">The owner</p>
        <h1 class="c-display c-rise mt-6 text-[11vw] leading-[0.98] sm:text-6xl lg:text-[4.4rem]" style="--d:60ms">
          {owner.name ? owner.name : 'The person'}<br /><em class="italic text-brass">behind the floor.</em>
        </h1>
        <div class="c-hair c-rise mt-10 max-w-sm" style="--d:110ms"></div>
        <p class="c-rise mt-8 max-w-xl text-sm leading-relaxed text-ash" style="--d:150ms">
          {owner.intro}
        </p>
        <dl class="c-rise mt-10 max-w-md border-t border-edge" style="--d:200ms">
          <div class="flex justify-between gap-6 border-b border-edge py-3 text-sm">
            <dt class="text-ash">Showroom</dt><dd class="text-right">{site.address.street}</dd>
          </div>
          <div class="flex justify-between gap-6 border-b border-edge py-3 text-sm">
            <dt class="text-ash">Direct</dt>
            <dd><a href={site.phoneHref} class="transition-colors hover:text-brass">{site.phone}</a></dd>
          </div>
        </dl>
        <div class="c-rise mt-10 flex flex-wrap gap-4" style="--d:250ms">
          <a href={site.phoneHref} class="c-btn c-btn-solid">Call the showroom</a>
          <a href={site.mapsLink} target="_blank" rel="noopener noreferrer" class="c-btn">Directions</a>
        </div>
      </div>
    </div>
  </section>

  <section class="c-section">
    <div class="c-wrap">
      <div class="c-rise">
        <p class="c-kicker">More from the floor</p>
        <h2 class="c-display mt-5 text-4xl sm:text-5xl">The rest of the showroom.</h2>
      </div>
      <div class="c-rise mt-12" style="--reels-radius:0px;--reels-muted:var(--color-ash);--reels-accent:var(--color-brass)">
        <VideoReels items={rest} />
      </div>
    </div>
  </section>
</V3Layout>

---
import { Image } from 'astro:assets';
import V3Layout from '../../layouts/V3Layout.astro';
import Lightbox from '../../components/v3/Lightbox.astro';
import { categories, gallery, productsHeroImage } from '../../data/content';
import { site } from '../../data/site';
import { url } from '../../lib/url';
---

<V3Layout title="Collections" description="Hardwood, laminate, luxury vinyl, carpet, tile and doors at the Boyles Flooring showroom in Santa Clarita.">
  <!-- ══════════ MASTHEAD ══════════ -->
  <section class="relative flex min-h-[62svh] items-end overflow-hidden border-b border-edge">
    <Image src={productsHeroImage} alt="" widths={[900, 1600]} sizes="100vw" loading="eager" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-void/78"></div>
    <div class="c-wrap relative z-10 py-16">
      <p class="c-kicker c-rise">The collections</p>
      <h1 class="c-display c-rise mt-6 max-w-3xl text-[12vw] leading-[0.98] sm:text-[8vw] lg:text-[5.5rem]" style="--d:70ms">
        Everything,<br /><em class="italic text-brass">under one roof.</em>
      </h1>
    </div>
  </section>

  <!-- ══════════ COLLECTION PANELS ══════════ -->
  {categories.map((c, i) => (
    <section id={c.slug} class="scroll-mt-4 border-b border-edge">
      <div class="grid lg:grid-cols-2">
        <div class:list={['c-grow c-rise min-h-[20rem] overflow-hidden lg:min-h-[34rem]', i % 2 === 1 ? 'lg:order-2 lg:border-l' : 'lg:border-r', 'border-edge']}>
          <Image
            src={c.image}
            alt={`${c.name} on display at the showroom`}
            widths={[700, 1300]}
            sizes="(min-width: 1024px) 50vw, 100vw"
            class="h-full w-full object-cover"
          />
        </div>

        <div class:list={['flex flex-col justify-center p-8 md:p-14 lg:p-20', i % 2 === 1 && 'lg:order-1']}>
          <p class="c-kicker c-rise">{String(i + 1).padStart(2, '0')} — Collection</p>
          <h2 class="c-display c-rise mt-5 text-4xl sm:text-5xl lg:text-6xl" style="--d:60ms">{c.name}</h2>
          <div class="c-hair c-rise mt-8 max-w-[12rem]" style="--d:100ms"></div>
          <p class="c-rise mt-8 max-w-lg text-sm leading-relaxed text-ash" style="--d:140ms">{c.body}</p>

          <dl class="c-rise mt-10 max-w-lg border-t border-edge" style="--d:190ms">
            {c.bullets.map((b, k) => (
              <div class="flex justify-between gap-6 border-b border-edge py-3 text-sm">
                <dt class="c-kicker !text-ash">{String(k + 1).padStart(2, '0')}</dt>
                <dd class="text-right text-cream">{b}</dd>
              </div>
            ))}
          </dl>

          <div class="c-rise mt-10" style="--d:240ms">
            <a href={url('/v3/contact')} class="c-btn">Enquire about {c.name.toLowerCase()}</a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- ══════════ PLATES ══════════ -->
  <section class="c-section">
    <div class="c-wrap">
      <div class="c-rise flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="c-kicker">Plates</p>
          <h2 class="c-display mt-5 text-4xl sm:text-5xl">The showroom floor.</h2>
        </div>
        <p class="max-w-xs text-right text-xs leading-relaxed text-ash">
          {site.address.street}<br />Select any plate to enlarge
        </p>
      </div>

      <ul class="mt-14 grid grid-cols-2 gap-4 md:grid-cols-3 md:gap-6">
        {gallery.map((g, i) => (
          <li>
            <button type="button" data-clb={i} class="c-grow group block w-full text-left" aria-label={`View larger: ${g.alt}`}>
              <div class="overflow-hidden border border-edge transition-colors group-hover:border-brass">
                <Image
                  src={g.image}
                  alt={g.alt}
                  widths={[400, 800]}
                  sizes="(min-width: 768px) 32vw, 50vw"
                  class="aspect-[4/3] w-full object-cover"
                />
              </div>
              <span class="c-kicker mt-3 block !text-ash transition-colors group-hover:!text-brass">
                Plate {String(i + 1).padStart(2, '0')}
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Lightbox items={gallery} />

  <!-- ══════════ CLOSE ══════════ -->
  <section class="border-t border-edge bg-panel">
    <div class="c-wrap grid gap-10 py-20 lg:grid-cols-12 lg:items-center">
      <h2 class="c-display c-rise text-4xl leading-[1.05] sm:text-5xl lg:col-span-6">
        Seen something<br />you like?
      </h2>
      <div class="c-rise lg:col-span-6" style="--d:80ms">
        <p class="max-w-md text-sm leading-relaxed text-ash">
          Tell us the room, the traffic and roughly the budget. We will point you
          at the handful of products that genuinely fit — and measure up whenever
          you are ready.
        </p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row">
          <a href={site.phoneHref} class="c-btn c-btn-solid">{site.phone}</a>
          <a href={url('/v3/contact')} class="c-btn">Send a message</a>
        </div>
      </div>
    </div>
  </section>
</V3Layout>

---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';
import { categories, services, heroImage, aboutImage, storefrontImage } from '../../data/content';
import { url } from '../../lib/url';
import InstagramEmbed from '../../components/InstagramEmbed.astro';
import { hasInstagramFeed } from '../../data/social';
---

<BaseLayout title={site.name}>
  <!-- ================= HERO ================= -->
  <section class="relative flex min-h-[92svh] items-end overflow-hidden">
    <Image
      src={heroImage}
      alt=""
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <!-- Two-stop scrim: keeps type legible without flattening the photo -->
    <div class="absolute inset-0 bg-gradient-to-t from-espresso/92 via-espresso/55 to-espresso/25"></div>

    <div class="wrap relative z-10 pb-20 pt-40 md:pb-28">
      <div class="max-w-3xl">
        <p class="reveal text-[0.6875rem] font-bold uppercase tracking-[0.22em] text-oak">
          Santa Clarita &middot; Flooring &amp; Doors
        </p>

        <h1
          class="reveal mt-5 font-display text-4xl leading-[1.08] text-bone sm:text-5xl md:text-6xl lg:text-[4.25rem]"
          style="--reveal-delay:80ms"
        >
          Floors worth<br />walking on.
        </h1>

        <p
          class="reveal mt-7 max-w-xl text-base leading-relaxed text-bone/80 md:text-lg"
          style="--reveal-delay:160ms"
        >
          Premium hardwood, laminate, luxury vinyl and doors — chosen with expert
          guidance, measured precisely, and installed to a clean, flawless finish.
        </p>

        <div class="reveal mt-10 flex flex-col gap-3 sm:flex-row" style="--reveal-delay:240ms">
          <a href={url('/v1/products')} class="btn btn-on-dark">Browse products</a>
          <a
            href={url('/v1/contact')}
            class="btn border border-bone/40 text-bone transition-colors hover:border-bone hover:bg-bone hover:text-espresso"
          >
            Book a consultation
          </a>
        </div>
      </div>
    </div>

    <!-- Category ticker pinned to the base of the hero -->
    <div class="absolute inset-x-0 bottom-0 z-10 border-t border-bone/15 bg-espresso/40 backdrop-blur-sm">
      <ul class="wrap flex flex-wrap items-center justify-center gap-x-8 gap-y-2 py-3.5 text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-bone/60">
        {categories.map((c) => <li>{c.name}</li>)}
      </ul>
    </div>
  </section>

  <!-- ================= WHO WE ARE ================= -->
  <section class="section">
    <div class="wrap grid items-center gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-6 lg:col-span-5">
        <SectionHeading
          eyebrow="Who we are"
          title="A showroom, not a warehouse."
          lead="Book your flooring consultation today and let our team of skilled professionals guide you in selecting the perfect materials to enhance your home."
        />
        <p class="reveal mt-5 max-w-xl leading-relaxed text-bark/70" style="--reveal-delay:80ms">
          Choosing a floor from a thumbnail is guesswork. Our Soledad Canyon Road
          showroom puts hundreds of full-size samples in front of you — real
          grain, real texture, real colour under real light — with someone on
          hand who knows which ones hold up where.
        </p>
        <div class="reveal mt-9" style="--reveal-delay:140ms">
          <a href={url('/v1/contact')} class="btn btn-ghost">Plan your visit</a>
        </div>
      </div>

      <div class="md:col-span-6 lg:col-span-7">
        <div class="reveal hover-zoom relative overflow-hidden" style="--reveal-delay:120ms">
          <Image
            src={aboutImage}
            alt="Inside the Boyles Flooring showroom, with sample racks lit by daylight from the storefront windows"
            widths={[600, 900, 1300]}
            sizes="(min-width: 768px) 55vw, 100vw"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CATEGORIES ================= -->
  <section class="section bg-sand">
    <div class="wrap">
      <SectionHeading
        eyebrow="What we carry"
        title="Every surface, under one roof."
        lead="Six categories, stocked and displayed side by side — so you can compare a laminate against the hardwood it imitates before you commit."
      />

      <ul class="mt-14 grid gap-px overflow-hidden bg-clay sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((c, i) => (
          <li class="reveal bg-sand" style={`--reveal-delay:${i * 70}ms`}>
            <a
              href={`${url('/v1/products')}#${c.slug}`}
              class="hover-zoom group flex h-full flex-col transition-colors hover:bg-bone"
            >
              <div class="relative overflow-hidden">
                <Image
                  src={c.image}
                  alt=""
                  widths={[400, 700]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                  class="aspect-[5/4] w-full object-cover"
                />
              </div>
              <div class="flex flex-1 flex-col p-7">
                <h3 class="text-xl">{c.name}</h3>
                <p class="mt-2.5 flex-1 text-sm leading-relaxed text-bark/65">{c.blurb}</p>
                <span
                  class="mt-6 inline-flex items-center gap-2 text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-oak-deep"
                >
                  Explore
                  <svg viewBox="0 0 24 24" class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= HOW IT WORKS ================= -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="How it works"
        title="From first look to final board."
        align="center"
      />

      <ol class="mt-16 grid gap-y-12 gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s, i) => (
          <li class="reveal relative" style={`--reveal-delay:${i * 80}ms`}>
            <span class="font-display text-5xl text-clay">{String(i + 1).padStart(2, '0')}</span>
            <div class="rule my-5"></div>
            <h3 class="text-lg">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-bark/65">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================= VISIT ================= -->
  <section class="section bg-sand">
    <div class="wrap grid items-center gap-12 md:grid-cols-12 md:gap-16">
      <div class="order-2 md:order-1 md:col-span-6">
        <div class="reveal hover-zoom overflow-hidden">
          <Image
            src={storefrontImage}
            alt="The Boyles Flooring storefront on Soledad Canyon Road in Santa Clarita"
            widths={[600, 900, 1300]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
      </div>

      <div class="order-1 md:order-2 md:col-span-6">
        <SectionHeading eyebrow="Visit us" title="Find us on Soledad Canyon Road." />

        <address class="reveal mt-8 not-italic" style="--reveal-delay:80ms">
          <a
            href={site.mapsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-start gap-3 text-lg leading-relaxed transition-colors hover:text-oak-deep"
          >
            <svg viewBox="0 0 24 24" class="mt-1.5 h-4 w-4 shrink-0 text-oak" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 21s-7-5.4-7-11a7 7 0 1 1 14 0c0 5.6-7 11-7 11Z" stroke-linejoin="round" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
            <span>
              {site.address.street}<br />
              {site.address.city}, {site.address.state} {site.address.zip}
            </span>
          </a>
        </address>

        <dl class="reveal mt-8 max-w-sm space-y-2.5" style="--reveal-delay:140ms">
          {site.hours.map((h) => (
            <div class="flex justify-between gap-6 border-b border-bark/10 pb-2.5 text-sm">
              <dt class="text-bark/60">{h.days}</dt>
              <dd class="font-semibold">{h.time}</dd>
            </div>
          ))}
        </dl>

        <div class="reveal mt-9 flex flex-col gap-3 sm:flex-row" style="--reveal-delay:200ms">
          <a href={site.phoneHref} class="btn btn-primary">Call {site.phone}</a>
          <a href={site.mapsLink} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Get directions</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= INSTAGRAM ================= -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="Follow along"
        title="Fresh off the showroom floor."
        lead="New arrivals, finished installs and the odd behind-the-scenes — posted as it happens."
      />
      {hasInstagramFeed() ? (
        <div class="reveal mt-12"><InstagramEmbed /></div>
      ) : (
        <div class="reveal mt-10 flex flex-wrap gap-3" style="--reveal-delay:80ms">
          <a href={site.social.instagram.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Instagram {site.social.instagram.handle}
          </a>
          <a href={site.social.tiktok.url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            TikTok {site.social.tiktok.handle}
          </a>
        </div>
      )}
    </div>
  </section>

  <CtaBand />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import { brands, colourCount } from '../../data/brands';
import { categories } from '../../data/content';
import { site } from '../../data/site';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return brands.map((b) => ({ params: { brand: b.slug }, props: { brand: b } }));
}

const { brand } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroImg = categories.find((c) => c.slug === 'laminate')?.image ?? categories[0].image;
const catName = (slug: string) => categories.find((c) => c.slug === slug)?.name ?? slug;
---

<BaseLayout
  title={brand.name}
  description={`${brand.name} at Boyles Flooring, ${site.address.city} — ${brand.collections.length} collections and ${colourCount(brand)} colours.`}
>
  <PageHero
    eyebrow="Brand"
    title={brand.name}
    lead={brand.blurb}
    image={heroImg}
  />

  <section class="section">
    <div class="wrap">
      <div class="reveal flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-xl">
          <p class="eyebrow">The range</p>
          <h2 class="mt-3 text-3xl sm:text-4xl">
            {brand.collections.length} collections, {colourCount(brand)} colours.
          </h2>
          <p class="mt-5 text-sm leading-relaxed text-bark/65">
            Grouped the way {brand.name} groups them. Open a collection to see
            every colour in it — then come in and see the ones you like at full
            size.
          </p>
        </div>
        <a href={brand.site} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          Manufacturer site
        </a>
      </div>

      {brand.lines.map((line) => {
        const cols = brand.collections.filter((c) => c.line === line.key);
        if (!cols.length) return null;
        return (
          <div class="mt-16">
            <div class="reveal flex flex-wrap items-baseline justify-between gap-3 border-b border-bark/15 pb-3">
              <h3 class="font-display text-2xl">{line.label}</h3>
              <a href={url(`/products/${line.category}`)} class="text-[0.65rem] font-bold uppercase tracking-[0.14em] text-oak-deep hover:underline">
                In {catName(line.category)}
              </a>
            </div>

            <ul class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
              {cols.map((c, i) => (
                <li class="reveal" style={`--reveal-delay:${Math.min(i * 50, 300)}ms`}>
                  <a href={url(`/brands/${brand.slug}/${c.slug}`)} class="group block">
                    <div class="grid grid-cols-4 gap-1">
                      {c.colours.slice(0, 4).map((sw) => (
                        <div class="overflow-hidden border border-bark/10 bg-sand">
                          {sw.image ? (
                            <img
                              src={`${base}/brands/${brand.imageDir}/${sw.image}`}
                              alt=""
                              loading="lazy" width="700" height="495"
                              class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105"
                            />
                          ) : <div class="aspect-square w-full"></div>}
                        </div>
                      ))}
                    </div>
                    <div class="mt-3 flex items-baseline justify-between gap-3">
                      <h4 class="text-lg leading-tight transition-colors group-hover:text-oak-deep">{c.title}</h4>
                      <span class="shrink-0 text-[0.65rem] uppercase tracking-[0.12em] text-bark/45">
                        {c.colours.length} colours
                      </span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })}

      <p class="reveal mt-14 max-w-2xl text-xs leading-relaxed text-bark/50">
        Collection names, colour names, product codes and swatch photography are
        {' '}{brand.name}'s own, shown here as a stockist. Screens render colour
        differently from the real thing — always judge a floor from a physical
        sample.
      </p>
    </div>
  </section>

  <CtaBand
    title={`Ask us about ${brand.name}`}
    body="Tell us which collection caught your eye and we will get a sample into your hands."
  />
</BaseLayout>

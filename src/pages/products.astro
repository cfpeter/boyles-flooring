---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Lightbox from '../components/Lightbox.astro';
import PageHero from '../components/PageHero.astro';
import { categories, gallery, productsHeroImage } from '../data/content';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<BaseLayout
  title="Products"
  description="Hardwood, laminate, luxury vinyl, carpet, tile and doors — on display at the Boyles Flooring showroom in Santa Clarita."
>
  <PageHero
    eyebrow="Products"
    title="Six categories. Hundreds of samples."
    lead="Ranges change with the seasons, so the showroom is always the fullest picture. Here is what we carry — come see the ones you like at full size."
    image={productsHeroImage}
  />

  <!-- Sticky category jump-nav -->
  <nav
    id="cat-nav"
    class="sticky top-0 z-30 border-b border-bark/10 bg-bone/90 backdrop-blur-md"
    aria-label="Product categories"
  >
    <ul class="wrap flex gap-1 overflow-x-auto py-2.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {categories.map((c) => (
        <li class="shrink-0">
          <a
            href={`#${c.slug}`}
            data-cat-link={c.slug}
            class="block whitespace-nowrap px-4 py-2 text-[0.6875rem] font-bold uppercase tracking-[0.14em] text-bark/55 transition-colors hover:text-bark aria-[current=true]:bg-bark aria-[current=true]:text-bone"
          >
            {c.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- ================= CATEGORY DETAIL ================= -->
  {categories.map((c, i) => (
    <section
      id={c.slug}
      class:list={['section scroll-mt-16', i % 2 === 1 && 'bg-sand']}
    >
      <div class="wrap grid items-center gap-12 md:grid-cols-12 md:gap-16">
        <div class:list={['md:col-span-6', i % 2 === 1 ? 'md:order-2' : '']}>
          <div class="reveal hover-zoom overflow-hidden">
            <Image
              src={c.image}
              alt={`${c.name} samples on display at the Boyles Flooring showroom`}
              widths={[600, 900, 1300]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
        </div>

        <div class:list={['md:col-span-6', i % 2 === 1 ? 'md:order-1' : '']}>
          <p class="eyebrow reveal">{String(i + 1).padStart(2, '0')} — Category</p>
          <h2 class="reveal mt-3 text-3xl sm:text-4xl" style="--reveal-delay:60ms">{c.name}</h2>
          <p class="reveal mt-5 leading-relaxed text-bark/70" style="--reveal-delay:110ms">{c.body}</p>

          <ul class="reveal mt-8 grid gap-x-6 gap-y-3 sm:grid-cols-2" style="--reveal-delay:170ms">
            {c.bullets.map((b) => (
              <li class="flex items-start gap-2.5 text-sm">
                <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-oak" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="text-bark/75">{b}</span>
              </li>
            ))}
          </ul>

          <div class="reveal mt-9" style="--reveal-delay:230ms">
            <a href={url('/contact')} class="btn btn-ghost">Ask about {c.name.toLowerCase()}</a>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- ================= SHOWROOM GALLERY ================= -->
  <section id="showroom" class="section bg-espresso text-bone">
    <div class="wrap">
      <div class="reveal max-w-2xl">
        <p class="eyebrow !text-oak">The showroom</p>
        <h2 class="mt-3 text-3xl sm:text-4xl md:text-[2.75rem]">Have a look around.</h2>
        <p class="mt-5 leading-relaxed text-bone/65">
          Photographs of the floor at {site.address.street.split(',')[0]}. Select
          any image to view it larger.
        </p>
      </div>

      <ul class="mt-14 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
        {gallery.map((item, i) => (
          <li class:list={[item.span === 'wide' && 'col-span-2']}>
            <button
              type="button"
              class="hover-zoom group block w-full overflow-hidden bg-bark"
              data-lightbox-index={i}
              aria-label={`View larger: ${item.alt}`}
            >
              <Image
                src={item.image}
                alt={item.alt}
                widths={[400, 800]}
                sizes="(min-width: 768px) 25vw, 50vw"
                class:list={[
                  'w-full object-cover transition-opacity duration-300 group-hover:opacity-90',
                  item.span === 'wide' ? 'aspect-[16/9]' : 'aspect-[4/3]',
                ]}
              />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Lightbox items={gallery} />

  <CtaBand
    title="Seen something you like?"
    body="Tell us the room, the traffic and roughly the budget. We will point you at the handful of products that genuinely fit — and measure up whenever you are ready."
  />
</BaseLayout>

<script>
  // Highlight the category tab for whichever section is currently in view.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]');
  const sections = [...links]
    .map((l) => document.getElementById(l.dataset.catLink!))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length) {
    const setActive = (slug: string | null) => {
      links.forEach((l) =>
        l.setAttribute('aria-current', String(l.dataset.catLink === slug))
      );
    };

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible) setActive(visible.target.id);
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: 0 }
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

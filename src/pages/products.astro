---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Lightbox from '../components/Lightbox.astro';
import PageHero from '../components/PageHero.astro';
import { categories, gallery, productsHeroImage } from '../data/content';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<BaseLayout
  title="Products"
  description="Hardwood, laminate, luxury vinyl, carpet, tile and doors — on display at the Boyles Flooring showroom in Santa Clarita."
>
  <PageHero
    eyebrow="Products"
    title="Six categories. Hundreds of samples."
    lead="Ranges change with the seasons, so the showroom is always the fullest picture. Here is what we carry — come see the ones you like at full size."
    image={productsHeroImage}
  />


  <!-- ================= CATEGORY INDEX ================= -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="Choose a surface"
        title="Six categories, and the brands behind them."
        lead="Open any category to see the lines we work with, and which of them are on the showroom floor right now."
      />

      <ul class="mt-14 grid gap-px overflow-hidden bg-clay sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((c, i) => (
          <li class="reveal bg-bone" style={`--reveal-delay:${i * 70}ms`}>
            <a href={url(`/products/${c.slug}`)} class="hover-zoom group flex h-full flex-col transition-colors hover:bg-sand">
              <div class="overflow-hidden">
                <Image
                  src={c.image}
                  alt=""
                  widths={[400, 700]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                  class="aspect-[5/4] w-full object-cover"
                />
              </div>
              <div class="flex flex-1 flex-col p-7">
                <h3 class="text-xl">{c.name}</h3>
                <p class="mt-2.5 flex-1 text-sm leading-relaxed text-bark/65">{c.blurb}</p>

                {c.brands.length > 0 && (
                  <p class="mt-4 text-xs leading-relaxed text-bark/50">
                    {c.brands.slice(0, 3).map((b) => b.name).join(' · ')}
                    {c.brands.length > 3 ? ` + ${c.brands.length - 3} more` : ''}
                  </p>
                )}

                <span class="mt-6 inline-flex items-center gap-2 text-[0.6875rem] font-bold uppercase tracking-[0.16em] text-oak-deep">
                  Explore
                  <svg viewBox="0 0 24 24" class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= SHOWROOM GALLERY ================= -->
  <section id="showroom" class="section bg-espresso text-bone">
    <div class="wrap">
      <div class="reveal max-w-2xl">
        <p class="eyebrow !text-oak">The showroom</p>
        <h2 class="mt-3 text-3xl sm:text-4xl md:text-[2.75rem]">Have a look around.</h2>
        <p class="mt-5 leading-relaxed text-bone/65">
          Photographs of the floor at {site.address.street.split(',')[0]}. Select
          any image to view it larger.
        </p>
      </div>

      <ul class="mt-14 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
        {gallery.map((item, i) => (
          <li class:list={[item.span === 'wide' && 'col-span-2']}>
            <button
              type="button"
              class="hover-zoom group block w-full overflow-hidden bg-bark"
              data-lightbox-index={i}
              aria-label={`View larger: ${item.alt}`}
            >
              <Image
                src={item.image}
                alt={item.alt}
                widths={[400, 800]}
                sizes="(min-width: 768px) 25vw, 50vw"
                class:list={[
                  'w-full object-cover transition-opacity duration-300 group-hover:opacity-90',
                  item.span === 'wide' ? 'aspect-[16/9]' : 'aspect-[4/3]',
                ]}
              />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Lightbox items={gallery} />

  <CtaBand
    title="Seen something you like?"
    body="Tell us the room, the traffic and roughly the budget. We will point you at the handful of products that genuinely fit — and measure up whenever you are ready."
  />
</BaseLayout>

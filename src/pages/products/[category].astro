---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import { categories } from '../../data/content';
import { site } from '../../data/site';
import { url } from '../../lib/url';
import { brands, colourCount } from '../../data/brands';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const others = categories.filter((c) => c.slug !== category.slug);
const onFloor = category.brands.filter((b) => b.onFloor);

/* A brand links through to its own catalogue only when we hold one. */
const catalogued = (name: string) =>
  brands.find((br) => br.name.toLowerCase() === name.toLowerCase());
---

<BaseLayout
  title={category.name}
  description={`${category.name} at Boyles Flooring, ${site.address.city}. ${category.blurb}`}
>
  <PageHero
    eyebrow={`Products — ${category.name}`}
    title={category.name}
    lead={category.blurb}
    image={category.image}
  />

  <!-- ================= OVERVIEW ================= -->
  <section class="section">
    <div class="wrap grid gap-12 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-7">
        <SectionHeading eyebrow="About the range" title={`Why people choose ${category.name.toLowerCase()}.`} />
        <p class="reveal mt-6 max-w-xl leading-relaxed text-bark/70" style="--reveal-delay:80ms">
          {category.body}
        </p>
        <ul class="reveal mt-9 grid max-w-xl gap-x-6 gap-y-3 sm:grid-cols-2" style="--reveal-delay:140ms">
          {category.bullets.map((b) => (
            <li class="flex items-start gap-2.5 text-sm">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-oak" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="text-bark/75">{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-5">
        <div class="reveal hover-zoom overflow-hidden" style="--reveal-delay:120ms">
          <Image
            src={category.image}
            alt={`${category.name} on display at the Boyles Flooring showroom`}
            widths={[500, 900]}
            sizes="(min-width: 768px) 40vw, 100vw"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ================= BRANDS ================= -->
  <section class="section bg-sand">
    <div class="wrap">
      {category.brands.length > 0 ? (
        <div>
          <SectionHeading
            eyebrow="The lines we work with"
            title={`${category.name} brands.`}
            lead={onFloor.length > 0
              ? 'Marked lines are on the showroom floor right now. The rest we order in — bring a sample or a photo and we will tell you what is available.'
              : 'Bring a sample or a photo and we will tell you what is available.'}
          />

          <ul class="mt-14 grid gap-px overflow-hidden bg-clay sm:grid-cols-2 lg:grid-cols-3">
            {category.brands.map((b, i) => {
              const cat = catalogued(b.name);
              const n = cat ? colourCount(cat, category.slug) : 0;
              const inner = (
                <div class="flex h-full items-center justify-between gap-4 p-6 transition-colors group-hover:bg-bone">
                  <span>
                    <span class="block font-display text-lg leading-tight">{b.name}</span>
                    {n > 0 && (
                      <span class="mt-1 block text-[0.65rem] uppercase tracking-[0.12em] text-oak-deep">
                        {n} colours &rarr;
                      </span>
                    )}
                  </span>
                  {b.onFloor && (
                    <span class="shrink-0 border border-oak/50 px-2.5 py-1 text-[0.6rem] font-bold uppercase tracking-[0.14em] text-oak-deep">
                      In store
                    </span>
                  )}
                </div>
              );
              return (
                <li class="reveal bg-sand" style={`--reveal-delay:${Math.min(i * 45, 400)}ms`}>
                  {cat ? (
                    <a href={url(`/products/${category.slug}/${cat.slug}`)} class="group block h-full">{inner}</a>
                  ) : (
                    <div class="group h-full">{inner}</div>
                  )}
                </li>
              );
            })}
          </ul>

          <p class="reveal mt-8 max-w-2xl text-xs leading-relaxed text-bark/55">
            Ranges change with the seasons and not every colour is stocked at all
            times. Call {site.phone} to check a specific line before you visit.
          </p>
        </div>
      ) : (
        <div class="max-w-2xl">
          <SectionHeading
            eyebrow="The lines we work with"
            title={`Ask about ${category.name.toLowerCase()}.`}
            lead="Stock in this category changes often, so rather than list ranges that may have moved on, call or come in and we will show you what is available today."
          />
          <div class="reveal mt-9 flex flex-wrap gap-3" style="--reveal-delay:80ms">
            <a href={site.phoneHref} class="btn btn-primary">Call {site.phone}</a>
            <a href={url('/contact')} class="btn btn-ghost">Send a message</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ================= OTHER CATEGORIES ================= -->
  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="Keep looking" title="The rest of the range." />
      <ul class="mt-12 grid gap-px overflow-hidden bg-clay sm:grid-cols-2 lg:grid-cols-5">
        {others.map((c, i) => (
          <li class="reveal bg-bone" style={`--reveal-delay:${i * 60}ms`}>
            <a href={url(`/products/${c.slug}`)} class="hover-zoom group flex h-full flex-col transition-colors hover:bg-sand">
              <div class="overflow-hidden">
                <Image
                  src={c.image}
                  alt=""
                  widths={[300, 600]}
                  sizes="(min-width: 1024px) 20vw, 50vw"
                  class="aspect-[4/3] w-full object-cover"
                />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-base leading-tight">{c.name}</h3>
                <span class="mt-3 inline-flex items-center gap-1.5 text-[0.65rem] font-bold uppercase tracking-[0.14em] text-oak-deep">
                  View
                  <svg viewBox="0 0 24 24" class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    title={`Talk to us about ${category.name.toLowerCase()}`}
    body="Tell us the room, the traffic and roughly the budget, and we will point you at the handful of products that genuinely fit."
  />
</BaseLayout>

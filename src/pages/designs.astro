---
import { site } from '../data/site';
import { url } from '../lib/url';

/* Standalone chooser for client review. Deliberately self-contained styling —
   it belongs to none of the four directions, so it borrows from none of them. */
const designs = [
  {
    key: 'A', name: 'Warm Classical', href: '/',
    note: 'Sand and bark with an oak accent, Libre Baskerville serif, full-bleed photography and card grids. Established and reassuring.',
    swatch: ['#ECE4DA', '#36302A', '#B5804A'], type: 'Libre Baskerville + Almarai',
  },
  {
    key: 'B', name: 'Swiss Editorial', href: '/v2',
    note: 'Paper white and near-black with burnt orange. Oversized Archivo set tight, asymmetric columns, a numbered index and a scrolling marquee.',
    swatch: ['#FBFAF8', '#14110E', '#C2551F'], type: 'Archivo + Inter',
  },
  {
    key: 'C', name: 'Dark Luxury Gallery', href: '/v3',
    note: 'Near-black and brass, high-contrast Cormorant Garamond, a fixed vertical nav rail and an interactive material selector.',
    swatch: ['#0C0F12', '#C9A96A', '#F2EDE4'], type: 'Cormorant Garamond + Jost',
  },
  {
    key: 'D', name: 'Bright Bento', href: '/v4',
    note: 'Linen, forest green, terracotta and honey. Rounded bento tiles, colour-blocked cards that stack as you scroll, a floating pill nav.',
    swatch: ['#FDFBF5', '#14342B', '#E2725B'], type: 'Bricolage Grotesque + DM Sans',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Design directions — {site.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Four design directions for the Boyles Flooring website." />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.png`} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0; background: #101012; color: #EDEBE7;
        font-family: Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 68rem; margin: 0 auto; padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 5vw, 2.5rem); }
      h1 { font-size: clamp(2rem, 6vw, 3.25rem); line-height: 1.05; letter-spacing: -0.03em; margin: 0.5rem 0 0; font-weight: 700; }
      .lede { max-width: 40rem; margin-top: 1.25rem; color: #9C9A94; line-height: 1.65; font-size: 0.95rem; }
      .tag { font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; color: #7C7A74; }
      .grid { display: grid; gap: 1rem; margin-top: 3.5rem; }
      @media (min-width: 46rem) { .grid { grid-template-columns: 1fr 1fr; } }
      .card {
        display: block; padding: 1.75rem; border: 1px solid #26262A; border-radius: 14px;
        background: #17171A; color: inherit; text-decoration: none;
        transition: border-color .25s, transform .25s, background-color .25s;
      }
      .card:hover { border-color: #55545C; background: #1C1C20; transform: translateY(-3px); }
      .card:focus-visible { outline: 2px solid #C2551F; outline-offset: 3px; }
      .key { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.18em; color: #7C7A74; }
      .name { font-size: 1.4rem; font-weight: 600; letter-spacing: -0.02em; margin: 0.5rem 0 0; }
      .note { color: #9C9A94; line-height: 1.6; font-size: 0.875rem; margin: 0.85rem 0 0; }
      .meta { margin-top: 1.15rem; font-size: 0.75rem; color: #6E6C67; }
      .sw { display: flex; gap: 0.4rem; margin-top: 1.15rem; }
      .sw span { width: 2.1rem; height: 2.1rem; border-radius: 6px; border: 1px solid rgba(255,255,255,.12); }
      .go { margin-top: 1.35rem; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.06em; }
      footer { border-top: 1px solid #26262A; margin-top: 3.5rem; padding-top: 1.5rem; font-size: 0.78rem; color: #6E6C67; }
      a.plain { color: #9C9A94; }
    </style>
  </head>
  <body>
    <main class="wrap">
      <p class="tag">{site.name} — website concepts</p>
      <h1>Four directions.<br />Same content, same photographs.</h1>
      <p class="lede">
        Each one is a complete, working site built from the real business details
        and the real showroom photography — so the comparison is about design,
        not placeholder copy. Open any of them, then use the badge in the corner
        to come back here.
      </p>

      <div class="grid">
        {designs.map((d) => (
          <a class="card" href={url(d.href)}>
            <p class="key">Design {d.key}</p>
            <p class="name">{d.name}</p>
            <p class="note">{d.note}</p>
            <div class="sw" aria-hidden="true">
              {d.swatch.map((c) => <span style={`background:${c}`}></span>)}
            </div>
            <p class="meta">{d.type}</p>
            <p class="go">View Design {d.key} &rarr;</p>
          </a>
        ))}
      </div>

      <footer>
        <p>
          {site.address.full} &middot;
          <a class="plain" href={site.phoneHref}>{site.phone}</a> &middot;
          <a class="plain" href={site.emailHref}>{site.email}</a>
        </p>
      </footer>
    </main>
  </body>
</html>

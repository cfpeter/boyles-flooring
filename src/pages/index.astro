---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';
import { url } from '../lib/url';

const asset = (p: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${p}`;

/* Landing page for client review. Styling is deliberately self-contained and
   neutral — it belongs to none of the four directions, so it favours none. */
const designs = [
  {
    key: 'A', name: 'Warm Classical', href: '/v1', shot: '/previews/design-a.jpg',
    note: 'Sand and bark with an oak accent. Serif headlines, full-bleed photography, card grids. Reads established and reassuring — the safest choice for a long-standing local business.',
    swatch: ['#ECE4DA', '#36302A', '#B5804A'], type: 'Libre Baskerville + Almarai',
  },
  {
    key: 'B', name: 'Swiss Editorial', href: '/v2', shot: '/previews/design-b.jpg',
    note: 'Paper white and near-black with burnt orange. Oversized type set tight, asymmetric columns, a numbered index and a scrolling marquee. Modern and confident.',
    swatch: ['#FBFAF8', '#14110E', '#C2551F'], type: 'Archivo + Inter',
  },
  {
    key: 'C', name: 'Dark Luxury Gallery', href: '/v3', shot: '/previews/design-c.jpg',
    note: 'Near-black and brass with a high-contrast serif. A fixed vertical nav rail and an interactive material selector. Treats the showroom like a gallery after hours.',
    swatch: ['#0C0F12', '#C9A96A', '#F2EDE4'], type: 'Cormorant Garamond + Jost',
  },
  {
    key: 'D', name: 'Bright Bento', href: '/v4', shot: '/previews/design-d.jpg',
    note: 'Linen, forest green, terracotta and honey. Rounded bento tiles and colour-blocked cards that stack as you scroll. The warmest and most contemporary of the four.',
    swatch: ['#FDFBF5', '#14342B', '#E2725B'], type: 'Bricolage Grotesque + DM Sans',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Design directions — {site.name}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Four website design directions for Boyles Flooring." />
    <link rel="icon" href={asset('/favicon.png')} type="image/png" />
    <meta property="og:title" content={`Design directions — ${site.name}`} />
    <meta property="og:image" content={asset('/og.jpg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0; background: #0E0E10; color: #EDEBE7;
        font-family: Inter, system-ui, -apple-system, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: inherit; }
      .wrap { max-width: 76rem; margin-inline: auto; padding-inline: clamp(1.25rem, 5vw, 2.5rem); }

      header { padding-block: clamp(2.5rem, 6vw, 4.5rem) 0; }
      .brand { display: flex; align-items: center; gap: 0.7rem; }
      .brand img { width: 34px; height: 34px; object-fit: contain; filter: brightness(0) invert(1); }
      .brand span { font-weight: 600; letter-spacing: -0.01em; }

      .tag { font-size: 0.7rem; letter-spacing: 0.24em; text-transform: uppercase; color: #7C7A74; margin: 2.75rem 0 0; }
      h1 { font-size: clamp(2rem, 5.5vw, 3.4rem); line-height: 1.04; letter-spacing: -0.035em; font-weight: 700; margin: 0.7rem 0 0; }
      .lede { max-width: 42rem; margin-top: 1.35rem; color: #9C9A94; line-height: 1.7; font-size: 0.97rem; }

      .grid { display: grid; gap: 1.25rem; margin: clamp(2.5rem, 6vw, 4rem) 0 0; }
      @media (min-width: 60rem) { .grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; } }

      .card {
        display: flex; flex-direction: column; text-decoration: none;
        border: 1px solid #26262A; border-radius: 16px; overflow: hidden;
        background: #151518;
        transition: border-color .3s, transform .3s, background-color .3s;
      }
      .card:hover { border-color: #5A5962; background: #1A1A1E; transform: translateY(-4px); }
      .card:focus-visible { outline: 2px solid #C2551F; outline-offset: 4px; }

      .shot { position: relative; aspect-ratio: 16 / 10; background: #202024; overflow: hidden; }
      .shot img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block;
                  transition: transform .6s cubic-bezier(.22,1,.36,1); }
      .card:hover .shot img { transform: scale(1.03); }
      .badge {
        position: absolute; top: 0.85rem; left: 0.85rem;
        background: rgba(14,14,16,.82); backdrop-filter: blur(6px);
        border: 1px solid rgba(255,255,255,.14); border-radius: 999px;
        padding: 0.3rem 0.75rem; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.14em;
      }

      .body { padding: 1.5rem 1.5rem 1.65rem; display: flex; flex-direction: column; flex: 1; }
      .name { font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; margin: 0; }
      .note { color: #9C9A94; line-height: 1.65; font-size: 0.875rem; margin: 0.7rem 0 0; flex: 1; }
      .meta { margin-top: 1.2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
      .sw { display: flex; gap: 0.35rem; }
      .sw span { width: 1.5rem; height: 1.5rem; border-radius: 5px; border: 1px solid rgba(255,255,255,.14); }
      .type { font-size: 0.72rem; color: #6E6C67; }
      .go { margin-top: 1.2rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em; display: inline-flex; align-items: center; gap: 0.45rem; }
      .card:hover .go { color: #E0A87A; }

      footer { border-top: 1px solid #26262A; margin-top: clamp(3rem, 7vw, 5rem); padding-block: 1.75rem 3rem; font-size: 0.82rem; color: #6E6C67; }
      footer a:hover { color: #EDEBE7; }
      .fnote { margin-top: 0.6rem; }

      @media (prefers-reduced-motion: reduce) {
        .card, .shot img { transition: none; }
        .card:hover { transform: none; }
        .card:hover .shot img { transform: none; }
      }
    </style>
  </head>

  <body>
    <header class="wrap">
      <div class="brand">
        <Image src={logo} alt="" width={34} height={34} />
        <span>{site.name}</span>
      </div>

      <p class="tag">Website concepts</p>
      <h1>Four directions.<br />Pick the one that feels like you.</h1>
      <p class="lede">
        Each is a complete, working website — not a picture of one. All four use
        your real address, hours and phone number, and your own showroom
        photographs, so what changes between them is purely the design. Open any
        one and click around; the badge in the bottom corner brings you back here.
      </p>
    </header>

    <main class="wrap">
      <div class="grid">
        {designs.map((d) => (
          <a class="card" href={url(d.href)}>
            <div class="shot">
              <img src={asset(d.shot)} alt={`Preview of Design ${d.key} — ${d.name}`} loading="lazy" width="800" height="500" />
              <span class="badge">Design {d.key}</span>
            </div>
            <div class="body">
              <p class="name">{d.name}</p>
              <p class="note">{d.note}</p>
              <div class="meta">
                <div class="sw" aria-hidden="true">
                  {d.swatch.map((c) => <span style={`background:${c}`}></span>)}
                </div>
                <span class="type">{d.type}</span>
              </div>
              <span class="go">View Design {d.key} &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </main>

    <footer class="wrap">
      <p>
        {site.address.full} &middot;
        <a href={site.phoneHref}>{site.phone}</a> &middot;
        <a href={site.emailHref}>{site.email}</a>
      </p>
      <p class="fnote">
        Every direction shares the same content, so a change to the phone number
        or opening hours updates all four at once.
      </p>
    </footer>
  </body>
</html>

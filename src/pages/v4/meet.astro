---
import V4Layout from '../../layouts/V4Layout.astro';
import FeatureVideo from '../../components/FeatureVideo.astro';
import VideoReels from '../../components/VideoReels.astro';
import { site } from '../../data/site';
import { owner, featuredReel, otherReels } from '../../data/reels';

const lead = featuredReel();
const rest = otherReels();
---

<V4Layout title="Meet Us" description="Meet the owner of Boyles Flooring, Santa Clarita.">
  <section class="d-wrap pt-4">
    <div class="grid gap-3 md:grid-cols-12">
      <div class="d-tile d-in bg-forest p-8 text-linen md:col-span-7 md:p-12">
        <p class="d-chip bg-linen/12 text-honey">Meet the owner</p>
        <h1 class="mt-6 font-bento text-[12vw] font-semibold leading-[0.92] sm:text-5xl lg:text-6xl">
          {owner.name ? `Hi, I'm ${owner.name}.` : 'The person behind the showroom.'}
        </h1>
        <p class="mt-7 max-w-md text-[0.95rem] leading-relaxed text-linen/75">{owner.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.phoneHref} class="d-btn d-btn-linen">Call {site.phone}</a>
          <a href={site.mapsLink} target="_blank" rel="noopener noreferrer"
             class="d-btn border-2 border-linen/30 text-linen hover:bg-linen hover:text-forest">Directions</a>
        </div>
      </div>

      <div class="d-in md:col-span-5" style="--reels-radius:1.25rem">
        <FeatureVideo reel={lead} />
        <p class="mt-3 text-sm text-fog">{lead.caption}</p>
      </div>
    </div>
  </section>

  <section class="d-section">
    <div class="d-wrap">
      <div class="d-in mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-bento text-3xl font-semibold sm:text-4xl lg:text-5xl">More from<br />the floor.</h2>
        <a href={site.social.instagram.url} target="_blank" rel="noopener noreferrer" class="d-chip bg-forest text-linen">
          {site.social.instagram.handle}
        </a>
      </div>
      <div class="d-in" style="--reels-radius:1rem;--reels-muted:var(--color-fog);--reels-accent:var(--color-rust)">
        <VideoReels items={rest} />
      </div>
    </div>
  </section>
</V4Layout>

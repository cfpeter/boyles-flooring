---
import { Image } from 'astro:assets';
import V4Layout from '../../layouts/V4Layout.astro';
import { categories, gallery } from '../../data/content';
import { site } from '../../data/site';
import { url } from '../../lib/url';

const skins = [
  { bg: 'bg-forest',   fg: 'text-linen',  sub: 'text-linen/70',  pill: 'bg-linen/12 text-honey' },
  { bg: 'bg-honey',    fg: 'text-forest', sub: 'text-forest/70', pill: 'bg-forest/12 text-forest' },
  { bg: 'bg-moss',     fg: 'text-linen',  sub: 'text-linen/75',  pill: 'bg-linen/15 text-linen' },
  { bg: 'bg-rust',     fg: 'text-white',  sub: 'text-white/80',  pill: 'bg-white/15 text-white' },
  { bg: 'bg-shell',    fg: 'text-forest', sub: 'text-fog',       pill: 'bg-forest/10 text-forest' },
  { bg: 'bg-graphite', fg: 'text-linen',  sub: 'text-linen/70',  pill: 'bg-linen/12 text-honey' },
];
---

<V4Layout title="Range" description="Hardwood, laminate, luxury vinyl, carpet, tile and doors at the Boyles Flooring showroom in Santa Clarita.">
  <!-- ══════════ HEAD ══════════ -->
  <section class="d-wrap pt-4">
    <div class="d-tile d-in bg-shell px-6 py-14 sm:px-12 md:py-20">
      <p class="d-chip bg-forest/10 text-forest">Our range</p>
      <h1 class="mt-6 font-bento text-[13vw] font-semibold leading-[0.92] sm:text-6xl lg:text-7xl">
        Everything,<br /><span class="text-rust">under one roof.</span>
      </h1>
      <p class="mt-7 max-w-xl text-[0.95rem] leading-relaxed text-fog">
        Ranges change with the seasons, so the showroom is always the fullest
        picture. Here is what we carry — come and see the ones you like at full size.
      </p>

      <!-- Jump chips -->
      <ul class="mt-9 flex flex-wrap gap-2">
        {categories.map((c) => (
          <li>
            <a href={`#${c.slug}`} class="d-chip bg-linen text-forest transition-colors hover:bg-forest hover:text-linen">
              {c.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══════════ CATEGORY TILES ══════════ -->
  <section class="d-wrap mt-3 space-y-3">
    {categories.map((c, i) => {
      const s = skins[i % skins.length];
      return (
        <div id={c.slug} class:list={['d-tile grid scroll-mt-24 gap-0 md:grid-cols-12', s.bg, s.fg]}>
          <div class:list={['d-pop min-h-[16rem] md:col-span-5', i % 2 === 1 && 'md:order-2']}>
            <Image
              src={c.image}
              alt={`${c.name} on display at the showroom`}
              widths={[600, 1100]}
              sizes="(min-width: 768px) 40vw, 100vw"
              class="h-full min-h-[16rem] w-full object-cover"
            />
          </div>
          <div class:list={['p-8 md:col-span-7 md:p-14', i % 2 === 1 && 'md:order-1']}>
            <p class:list={['d-chip', s.pill]}>{String(i + 1).padStart(2, '0')}</p>
            <h2 class="mt-6 font-bento text-4xl font-semibold leading-[0.95] sm:text-5xl">{c.name}</h2>
            <p class:list={['mt-5 max-w-lg text-[0.95rem] leading-relaxed', s.sub]}>{c.body}</p>
            <ul class="mt-7 flex flex-wrap gap-2">
              {c.bullets.map((b) => <li class:list={['d-chip', s.pill]}>{b}</li>)}
            </ul>
            <a href={url('/v4/contact')} class:list={['d-btn mt-8', i === 1 || i === 4 ? 'd-btn-forest' : 'd-btn-linen']}>
              Ask about {c.name.toLowerCase()}
            </a>
          </div>
        </div>
      );
    })}
  </section>

  <!-- ══════════ FULL GALLERY ══════════ -->
  <section class="d-section">
    <div class="d-wrap">
      <div class="d-in mb-6 flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-bento text-3xl font-semibold sm:text-4xl lg:text-5xl">The whole floor.</h2>
        <p class="max-w-xs text-sm text-fog">{site.address.street}</p>
      </div>
      <div class="d-in grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {gallery.map((g) => (
          <figure class="d-tile d-pop">
            <Image
              src={g.image}
              alt={g.alt}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 24vw, 45vw"
              class="aspect-[4/3] w-full object-cover"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>
</V4Layout>

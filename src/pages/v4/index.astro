---
import { Image } from 'astro:assets';
import V4Layout from '../../layouts/V4Layout.astro';
import { site } from '../../data/site';
import { categories, services, gallery, heroImage, storefrontImage } from '../../data/content';
import { url } from '../../lib/url';
import InstagramEmbed from '../../components/InstagramEmbed.astro';
import { hasInstagramFeed } from '../../data/social';

/* Each category card gets its own colourway — the point of this direction */
const skins = [
  { bg: 'bg-forest',   fg: 'text-linen',  sub: 'text-linen/70',  pill: 'bg-linen/12 text-honey' },
  { bg: 'bg-honey',    fg: 'text-forest', sub: 'text-forest/70', pill: 'bg-forest/12 text-forest' },
  { bg: 'bg-moss',     fg: 'text-linen',  sub: 'text-linen/75',  pill: 'bg-linen/15 text-linen' },
  { bg: 'bg-rust',     fg: 'text-white',  sub: 'text-white/80',  pill: 'bg-white/15 text-white' },
  { bg: 'bg-shell',    fg: 'text-forest', sub: 'text-fog',       pill: 'bg-forest/10 text-forest' },
  { bg: 'bg-graphite', fg: 'text-linen',  sub: 'text-linen/70',  pill: 'bg-linen/12 text-honey' },
];

const bento = gallery.slice(0, 7);
const spans = [
  'sm:col-span-2 sm:row-span-2', 'sm:col-span-2', 'sm:col-span-2',
  'sm:col-span-2', 'sm:col-span-2', 'sm:col-span-2', 'sm:col-span-4',
];
---

<V4Layout title="Home">
  <!-- ══════════════ BENTO HERO ══════════════ -->
  <section class="d-wrap pt-4">
    <div class="grid gap-3 md:grid-cols-12">
      <div class="d-tile d-in bg-shell p-8 md:col-span-7 md:p-12">
        <p class="d-chip bg-forest/10 text-forest">Santa Clarita, CA</p>
        <h1 class="mt-6 font-bento text-[13vw] font-semibold leading-[0.92] sm:text-6xl lg:text-7xl">
          Floors your<br />house will<br /><span class="text-rust">grow into.</span>
        </h1>
        <p class="mt-7 max-w-md text-[0.95rem] leading-relaxed text-fog">
          Hardwood, laminate, luxury vinyl, carpet, tile and doors — chosen with
          you in the showroom, measured precisely, installed beautifully.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={url('/v4/products')} class="d-btn d-btn-forest">Explore the range</a>
          <a href={url('/v4/contact')} class="d-btn d-btn-outline">Book a visit</a>
        </div>
      </div>

      <div class="d-tile d-pop d-in min-h-[18rem] md:col-span-5 md:row-span-2" style="--d:80ms">
        <Image
          src={heroImage}
          alt="Flooring samples on display at the Boyles Flooring showroom"
          widths={[700, 1200]}
          sizes="(min-width: 768px) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full min-h-[18rem] w-full object-cover"
        />
      </div>

      <div class="d-tile d-in bg-forest p-8 text-linen md:col-span-4" style="--d:140ms">
        <p class="text-xs font-semibold uppercase tracking-widest text-honey">What we carry</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {categories.map((c) => (
            <li class="d-chip bg-linen/12 text-linen">{c.name}</li>
          ))}
        </ul>
      </div>

      <div class="d-tile d-in bg-honey p-8 md:col-span-3" style="--d:200ms">
        <p class="text-xs font-semibold uppercase tracking-widest text-forest/60">Open today</p>
        <p class="mt-4 font-bento text-2xl font-semibold leading-tight">{site.hours[0].time}</p>
        <a href={site.mapsLink} target="_blank" rel="noopener noreferrer" class="mt-4 block text-sm leading-relaxed text-forest/75 underline underline-offset-4">
          {site.address.street}
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════ STATEMENT ══════════════ -->
  <section class="d-section">
    <div class="d-wrap grid gap-8 lg:grid-cols-12">
      <p class="d-in d-chip h-fit bg-shell text-forest lg:col-span-3">Who we are</p>
      <div class="lg:col-span-9">
        <p class="d-in font-bento text-2xl font-semibold leading-[1.25] sm:text-3xl lg:text-4xl">
          Choosing a floor from a thumbnail is guesswork.
          <span class="text-fog">So we built a room full of the real thing — hundreds of
          full-size samples, side by side, under real light.</span>
        </p>
        <p class="d-in mt-8 max-w-2xl text-[0.95rem] leading-relaxed text-fog" style="--d:80ms">
          Book your flooring consultation today and let our team of skilled
          professionals guide you in selecting the perfect materials to enhance
          your home. Our experts are committed to delivering top-notch service
          and tailored solutions for all your flooring needs.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════ STACKING CATEGORY CARDS ══════════════ -->
  <section class="d-wrap pb-4">
    <div class="d-in mb-6 flex flex-wrap items-end justify-between gap-4">
      <h2 class="font-bento text-3xl font-semibold sm:text-4xl lg:text-5xl">Six ways to<br />finish a room.</h2>
      <a href={url('/v4/products')} class="d-btn d-btn-outline !py-3 !text-sm">See the full range</a>
    </div>

    <!-- Cards stick in sequence, so each one rises over the last -->
    <ul class="d-stack space-y-4">
      {categories.map((c, i) => {
        const s = skins[i % skins.length];
        return (
          <li style={`--stick:${5.5 + i * 0.65}rem`}>
            <div class:list={['d-tile grid gap-0 md:grid-cols-12', s.bg, s.fg]}>
              <div class="p-8 md:col-span-7 md:p-12">
                <p class:list={['d-chip', s.pill]}>{String(i + 1).padStart(2, '0')} — {c.name}</p>
                <h3 class="mt-6 font-bento text-4xl font-semibold leading-[0.95] sm:text-5xl">{c.name}</h3>
                <p class:list={['mt-5 max-w-lg text-[0.95rem] leading-relaxed', s.sub]}>{c.body}</p>
                <ul class="mt-7 flex flex-wrap gap-2">
                  {c.bullets.map((b) => <li class:list={['d-chip', s.pill]}>{b}</li>)}
                </ul>
              </div>
              <div class="d-pop min-h-[14rem] md:col-span-5">
                <Image
                  src={c.image}
                  alt={`${c.name} on display at the showroom`}
                  widths={[600, 1000]}
                  sizes="(min-width: 768px) 40vw, 100vw"
                  class="h-full min-h-[14rem] w-full object-cover"
                />
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- ══════════════ BENTO GALLERY ══════════════ -->
  <section class="d-section">
    <div class="d-wrap">
      <div class="d-in mb-6 flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-bento text-3xl font-semibold sm:text-4xl lg:text-5xl">Inside the showroom.</h2>
        <p class="max-w-xs text-sm text-fog">Come and stand on it — samples go home with you.</p>
      </div>

      <div class="d-in grid auto-rows-[11rem] grid-cols-2 gap-3 sm:grid-cols-4 sm:auto-rows-[13rem]">
        {bento.map((g, i) => (
          <figure class:list={['d-tile d-pop', spans[i]]}>
            <Image
              src={g.image}
              alt={g.alt}
              widths={[400, 900]}
              sizes="(min-width: 640px) 45vw, 90vw"
              class="h-full w-full object-cover"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════ PROCESS ══════════════ -->
  <section class="d-wrap pb-4">
    <div class="d-tile bg-shell px-6 py-14 sm:px-10 md:py-20">
      <h2 class="d-in font-bento text-3xl font-semibold sm:text-4xl lg:text-5xl">
        From first look<br />to final board.
      </h2>
      <ol class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s, i) => (
          <li class="d-tile d-in bg-linen p-7" style={`--d:${i * 70}ms`}>
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-rust font-bento text-sm font-bold text-white">
              {i + 1}
            </span>
            <h3 class="mt-5 font-bento text-lg font-semibold">{s.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-fog">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════════ INSTAGRAM ══════════════ -->
  <section class="d-wrap pb-4">
    <div class="d-tile bg-shell px-6 py-14 sm:px-10 md:py-16">
      <div class="d-in flex flex-wrap items-end justify-between gap-4">
        <h2 class="font-bento text-3xl font-semibold sm:text-4xl">Fresh off the<br />showroom floor.</h2>
        <a href={site.social.instagram.url} target="_blank" rel="noopener noreferrer" class="d-chip bg-forest text-linen">
          {site.social.instagram.handle}
        </a>
      </div>
      {hasInstagramFeed() ? (
        <div class="d-in mt-10"><InstagramEmbed /></div>
      ) : (
        <div class="d-in mt-8 flex flex-wrap gap-3" style="--d:80ms">
          <a href={site.social.instagram.url} target="_blank" rel="noopener noreferrer" class="d-btn d-btn-forest">Instagram</a>
          <a href={site.social.tiktok.url} target="_blank" rel="noopener noreferrer" class="d-btn d-btn-outline">TikTok</a>
        </div>
      )}
    </div>
  </section>

  <!-- ══════════════ VISIT ══════════════ -->
  <section class="d-section">
    <div class="d-wrap grid gap-3 md:grid-cols-12">
      <div class="d-tile d-pop d-in min-h-[20rem] md:col-span-7">
        <Image
          src={storefrontImage}
          alt="The Boyles Flooring storefront on Soledad Canyon Road"
          widths={[700, 1300]}
          sizes="(min-width: 768px) 58vw, 100vw"
          class="h-full min-h-[20rem] w-full object-cover"
        />
      </div>

      <div class="d-tile d-in bg-rust p-8 text-white md:col-span-5 md:p-12" style="--d:80ms">
        <p class="d-chip bg-white/15 text-white">Visit us</p>
        <h2 class="mt-6 font-bento text-4xl font-semibold leading-[0.95] sm:text-5xl">
          Come and<br />stand on it.
        </h2>
        <dl class="mt-8">
          {site.hours.map((h) => (
            <div class="flex justify-between gap-4 border-b border-white/20 py-3 text-sm">
              <dt class="text-white/80">{h.days}</dt><dd class="font-semibold">{h.time}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.phoneHref} class="d-btn d-btn-linen">{site.phone}</a>
          <a href={site.mapsLink} target="_blank" rel="noopener noreferrer" class="d-btn border-2 border-white/40 text-white hover:bg-white hover:text-rust">
            Directions
          </a>
        </div>
      </div>
    </div>
  </section>
</V4Layout>

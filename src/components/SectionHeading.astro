---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
}
const { eyebrow, title, lead, align = 'left', tone = 'dark' } = Astro.props;
---

<div
  class:list={[
    'reveal max-w-2xl',
    align === 'center' && 'mx-auto text-center',
    tone === 'light' && 'text-bone',
  ]}
>
  {eyebrow && <p class:list={['eyebrow', tone === 'light' && '!text-oak']}>{eyebrow}</p>}
  <h2 class="mt-3 text-3xl leading-[1.15] sm:text-4xl md:text-[2.75rem]">{title}</h2>
  {lead && (
    <p class:list={['mt-5 text-base leading-relaxed', tone === 'light' ? 'text-bone/70' : 'text-bark/70']}>
      {lead}
    </p>
  )}
</div>

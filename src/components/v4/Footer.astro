---
import { site } from '../../data/site';
import { url } from '../../lib/url';
const year = new Date().getFullYear();
---

<footer class="px-3 pb-3 sm:px-4 sm:pb-4">
  <div class="d-tile bg-forest px-6 py-14 text-linen sm:px-10 md:py-20">
    <div class="d-wrap">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="font-bento text-4xl font-semibold leading-[0.95] md:text-5xl">
            Let's find your<br /><span class="text-honey">perfect floor.</span>
          </h2>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.phoneHref} class="d-btn d-btn-linen">{site.phone}</a>
            <a href={url('/v4/contact')} class="d-btn border-2 border-linen/30 text-linen hover:bg-linen hover:text-forest">
              Book a visit
            </a>
          </div>
        </div>

        <div class="grid gap-8 sm:grid-cols-3 lg:col-span-7">
          <div>
            <p class="d-chip bg-linen/10 text-honey">Showroom</p>
            <address class="mt-4 not-italic text-sm leading-relaxed text-linen/75">
              <a href={site.mapsLink} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-honey">
                {site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}
              </a>
            </address>
          </div>
          <div>
            <p class="d-chip bg-linen/10 text-honey">Hours</p>
            <dl class="mt-4 space-y-1.5 text-sm text-linen/75">
              {site.hours.map((h) => (
                <div class="flex justify-between gap-3">
                  <dt>{h.days.replace(' – ', '–')}</dt><dd class="text-linen">{h.time}</dd>
                </div>
              ))}
            </dl>
          </div>
          <div>
            <p class="d-chip bg-linen/10 text-honey">Follow</p>
            <nav class="mt-4 flex flex-col gap-2 text-sm text-linen/75" aria-label="Footer">
              <a href={url('/v4/products')} class="transition-colors hover:text-honey">Our range</a>
              <a href={url('/v4/meet')} class="transition-colors hover:text-honey">Meet us</a>
              <a href={url('/v4/contact')} class="transition-colors hover:text-honey">Contact</a>
              <a href={site.social.instagram.url} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-honey">Instagram</a>
              <a href={site.social.tiktok.url} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-honey">TikTok</a>
            </nav>
          </div>
        </div>
      </div>

      <p class="mt-14 border-t border-linen/15 pt-6 text-xs text-linen/50">
        &copy; {year} {site.name} — Santa Clarita, California
      </p>
    </div>
  </div>
</footer>

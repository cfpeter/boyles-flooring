---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { site } from '../../data/site';
import { url, isActive } from '../../lib/url';

const nav = [
  { label: 'Home', href: '/v4' },
  { label: 'Range', href: '/v4/products' },
  { label: 'Visit', href: '/v4/contact' },
];
const pathname = Astro.url.pathname;
---

<!-- Floating pill nav — distinct from A's transparent bar, B's ruled bar
     and C's vertical rail. -->
<div class="sticky top-0 z-50 px-3 pt-3 sm:px-4 sm:pt-4">
  <header class="d-wrap flex items-center justify-between gap-4 rounded-[var(--radius-pill)] border border-forest/10 bg-linen/90 py-2.5 pl-3 pr-2.5 shadow-[0_6px_24px_-12px_rgba(20,52,43,0.35)] backdrop-blur-lg sm:pl-5">
    <a href={url('/v4')} class="relative z-50 flex items-center gap-2.5" aria-label={`${site.name} — home`}>
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-forest">
        <Image src={logo} alt="" width={22} height={22} loading="eager" class="h-5 w-5 object-contain brightness-0 invert" />
      </span>
      <span class="font-bento text-base font-semibold tracking-tight">Boyles</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={url(item.href)}
          aria-current={isActive(item.href, pathname) ? 'page' : undefined}
          class="rounded-[var(--radius-pill)] px-4 py-2 text-sm font-medium text-fog transition-colors hover:bg-shell hover:text-forest aria-[current=page]:bg-forest aria-[current=page]:text-linen"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.phoneHref} class="hidden text-sm font-semibold sm:block lg:mr-1">{site.phone}</a>
      <a href={url('/v4/contact')} class="d-btn d-btn-rust hidden !px-5 !py-2.5 !text-sm sm:inline-flex">Free quote</a>

      <button
        id="d-toggle"
        type="button"
        class="relative z-50 flex h-10 w-10 items-center justify-center rounded-full bg-shell lg:hidden"
        aria-label="Open menu" aria-expanded="false" aria-controls="d-menu"
      >
        <span class="flex w-5 flex-col gap-[5px]" aria-hidden="true">
          <span class="d-bar h-[2px] w-full rounded bg-forest transition-transform duration-300"></span>
          <span class="d-bar-mid h-[2px] w-full rounded bg-forest transition-opacity duration-200"></span>
          <span class="d-bar h-[2px] w-full rounded bg-forest transition-transform duration-300"></span>
        </span>
      </button>
    </div>
  </header>
</div>

<!-- Mobile sheet -->
<div id="d-menu" class="fixed inset-0 z-40 flex-col bg-forest px-6 pb-8 pt-24 text-linen lg:hidden">
  <nav class="flex flex-1 flex-col justify-center gap-3" aria-label="Mobile">
    {nav.map((item) => (
      <a
        href={url(item.href)}
        aria-current={isActive(item.href, pathname) ? 'page' : undefined}
        class="d-tile flex items-center justify-between bg-linen/10 px-6 py-6 font-bento text-3xl font-semibold aria-[current=page]:bg-honey aria-[current=page]:text-forest"
      >
        {item.label}
        <span aria-hidden="true">&rarr;</span>
      </a>
    ))}
  </nav>
  <div class="mt-6 grid gap-3">
    <a href={site.phoneHref} class="d-btn d-btn-linen">{site.phone}</a>
    <a href={site.emailHref} class="text-center text-sm text-linen/70">{site.email}</a>
  </div>
</div>

<style>
  #d-toggle[aria-expanded='true'] { background: var(--color-honey); }
  #d-toggle[aria-expanded='true'] .d-bar-mid { opacity: 0; }
  #d-toggle[aria-expanded='true'] .d-bar:first-child { transform: translateY(7px) rotate(45deg); }
  #d-toggle[aria-expanded='true'] .d-bar:last-child { transform: translateY(-7px) rotate(-45deg); }
</style>

<script>
  const toggle = document.getElementById('d-toggle')!;
  const menu = document.getElementById('d-menu')!;
  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('open', open);
    document.body.classList.toggle('d-locked', open);
  };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
  });
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>

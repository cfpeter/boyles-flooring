---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image: ImageMetadata;
}
const { eyebrow, title, lead, image } = Astro.props;
---

<!-- Interior page header. Uses a photo + scrim rather than a flat colour so the
     transparent site header always has enough contrast to sit on. -->
<section class="relative flex min-h-[58svh] items-end overflow-hidden md:min-h-[62svh]">
  <Image
    src={image}
    alt=""
    widths={[800, 1400, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover [object-position:center_62%]"
  />
  <!-- Weighted to the bottom, where the text sits, so a bright photograph
       still reads at the top instead of being flattened by the scrim. -->
  <div class="absolute inset-0 bg-gradient-to-t from-espresso/94 via-espresso/60 to-espresso/20"></div>

  <div class="wrap relative z-10 pb-14 pt-36 md:pb-16 md:pt-40">
    <p class="reveal text-[0.6875rem] font-bold uppercase tracking-[0.22em] text-oak">{eyebrow}</p>
    <h1
      class="reveal mt-4 max-w-3xl font-display text-4xl leading-[1.1] text-bone sm:text-5xl md:text-6xl"
      style="--reveal-delay:70ms"
    >
      {title}
    </h1>
    {lead && (
      <p class="reveal mt-6 max-w-xl leading-relaxed text-bone/80" style="--reveal-delay:140ms">
        {lead}
      </p>
    )}
  </div>
</section>

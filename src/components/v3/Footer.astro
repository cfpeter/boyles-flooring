---
import { site } from '../../data/site';
import { url } from '../../lib/url';
const year = new Date().getFullYear();
---

<footer class="border-t border-edge bg-panel">
  <div class="c-wrap py-16 md:py-24">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="c-kicker">Boyles Flooring</p>
        <p class="c-display mt-5 text-4xl leading-[1.05] md:text-5xl">
          Santa Clarita's<br />flooring showroom.
        </p>
        <div class="c-hair mt-8 max-w-xs"></div>
      </div>

      <div class="grid gap-10 sm:grid-cols-3 lg:col-span-7">
        <div>
          <p class="c-kicker !text-ash">Visit</p>
          <address class="mt-4 not-italic text-sm leading-relaxed text-ash">
            <a href={site.mapsLink} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-brass">
              {site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}
            </a>
          </address>
          <dl class="mt-5 space-y-1.5 text-xs text-ash">
            {site.hours.map((h) => (
              <div class="flex justify-between gap-3">
                <dt>{h.days}</dt><dd class="text-cream">{h.time}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div>
          <p class="c-kicker !text-ash">Contact</p>
          <div class="mt-4 space-y-2 text-sm">
            <a href={site.phoneHref} class="c-display block text-2xl transition-colors hover:text-brass">{site.phone}</a>
            <a href={site.emailHref} class="block break-all text-ash transition-colors hover:text-brass">{site.email}</a>
          </div>
        </div>

        <div>
          <p class="c-kicker !text-ash">Index</p>
          <nav class="mt-4 flex flex-col gap-2 text-sm text-ash" aria-label="Footer">
            <a href={url('/v3')} class="transition-colors hover:text-brass">Gallery</a>
            <a href={url('/v3/products')} class="transition-colors hover:text-brass">Collections</a>
            <a href={url('/v3/meet')} class="transition-colors hover:text-brass">The Owner</a>
            <a href={url('/v3/contact')} class="transition-colors hover:text-brass">Enquire</a>
            <a href={site.social.instagram.url} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-brass">Instagram</a>
            <a href={site.social.tiktok.url} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-brass">TikTok</a>
          </nav>
        </div>
      </div>
    </div>

    <p class="mt-16 border-t border-edge pt-6 text-[0.7rem] uppercase tracking-[0.2em] text-ash/70">
      &copy; {year} {site.name}
    </p>
  </div>
</footer>

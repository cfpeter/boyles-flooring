---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { items: { image: ImageMetadata; alt: string }[]; }
const { items } = Astro.props;
const slides = await Promise.all(items.map(async (i) => {
  const o = await getImage({ src: i.image, width: 1600, format: 'webp' });
  return { src: o.src, alt: i.alt };
}));
---

<div id="c-lb" class="fixed inset-0 z-[70] flex-col bg-void/98" role="dialog" aria-modal="true" aria-label="Image viewer">
  <div class="flex items-center justify-between px-6 py-5">
    <p id="c-lb-n" class="c-kicker"></p>
    <button id="c-lb-x" type="button" class="flex h-11 w-11 items-center justify-center text-ash transition-colors hover:text-brass" aria-label="Close viewer">
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
    </button>
  </div>
  <div class="relative flex flex-1 items-center justify-center px-4 pb-4 md:px-24">
    <button id="c-lb-p" type="button" class="absolute left-2 z-10 flex h-12 w-12 items-center justify-center border border-edge text-ash transition-colors hover:border-brass hover:text-brass md:left-8" aria-label="Previous image">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <img id="c-lb-i" src="" alt="" class="max-h-full max-w-full object-contain" />
    <button id="c-lb-x2" type="button" class="absolute right-2 z-10 flex h-12 w-12 items-center justify-center border border-edge text-ash transition-colors hover:border-brass hover:text-brass md:right-8" aria-label="Next image">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <p id="c-lb-c" class="px-6 pb-8 text-center text-xs tracking-wide text-ash"></p>
</div>

<style>
  /* Structural toggle only — never gated on a transition or animation */
  #c-lb { display: none; }
  #c-lb.open { display: flex; }
</style>

<script is:inline define:vars={{ slides }}>
  (function () {
    const box = document.getElementById('c-lb');
    if (!box || !slides.length) return;
    const img = document.getElementById('c-lb-i'), cap = document.getElementById('c-lb-c'),
          n = document.getElementById('c-lb-n'), x = document.getElementById('c-lb-x'),
          p = document.getElementById('c-lb-p'), nx = document.getElementById('c-lb-x2');
    let i = 0, last = null;
    const show = (k) => {
      i = (k + slides.length) % slides.length;
      img.src = slides[i].src; img.alt = slides[i].alt;
      cap.textContent = slides[i].alt;
      n.textContent = `${String(i + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
    };
    const open = (k) => { last = document.activeElement; show(k); box.classList.add('open'); document.body.classList.add('c-locked'); x.focus(); };
    const close = () => { box.classList.remove('open'); document.body.classList.remove('c-locked'); img.src = ''; if (last) last.focus(); };

    document.querySelectorAll('[data-clb]').forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.clb))));
    x.addEventListener('click', close);
    p.addEventListener('click', () => show(i - 1));
    nx.addEventListener('click', () => show(i + 1));
    box.addEventListener('click', (e) => { if (e.target === box || e.target.id === 'c-lb-c') close(); });
    document.addEventListener('keydown', (e) => {
      if (!box.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
      if (e.key === 'Tab') {
        const f = [x, p, nx], at = f.indexOf(document.activeElement);
        if (at === -1) return;
        e.preventDefault();
        f[((e.shiftKey ? at - 1 : at + 1) + f.length) % f.length].focus();
      }
    });
    let sx = null;
    box.addEventListener('touchstart', (e) => { sx = e.changedTouches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      if (sx === null) return;
      const d = e.changedTouches[0].clientX - sx;
      if (Math.abs(d) > 50) show(d > 0 ? i - 1 : i + 1);
      sx = null;
    }, { passive: true });
  })();
</script>

---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { site } from '../../data/site';
import { url, isActive } from '../../lib/url';

const nav = [
  { label: 'Gallery', href: '/v3' },
  { label: 'Collections', href: '/v3/products' },
  { label: 'Enquire', href: '/v3/contact' },
];
const pathname = Astro.url.pathname;
---

<!-- ═════ Fixed vertical rail (wide screens only) ═════ -->
<aside class="fixed inset-y-0 left-0 z-50 hidden w-24 flex-col items-center justify-between border-r border-edge bg-void py-8 xl:flex">
  <a href={url('/v3')} aria-label={`${site.name} — home`} class="block">
    <Image src={logo} alt="" width={36} height={36} class="h-9 w-9 object-contain brightness-0 invert" />
  </a>

  <!-- Vertical navigation — the signature of this direction -->
  <nav class="flex flex-col items-center gap-10" aria-label="Main">
    {nav.map((item) => (
      <a
        href={url(item.href)}
        aria-current={isActive(item.href, pathname) ? 'page' : undefined}
        class="text-[0.7rem] uppercase tracking-[0.3em] text-ash transition-colors hover:text-cream aria-[current=page]:text-brass"
        style="writing-mode: vertical-rl;"
      >
        {item.label}
      </a>
    ))}
  </nav>

  <a
    href={site.phoneHref}
    class="text-[0.65rem] uppercase tracking-[0.28em] text-ash transition-colors hover:text-brass"
    style="writing-mode: vertical-rl;"
  >
    {site.phone}
  </a>
</aside>

<!-- ═════ Top bar (below xl) ═════ -->
<header class="sticky top-0 z-50 border-b border-edge bg-void/90 backdrop-blur-md xl:hidden">
  <div class="flex items-center justify-between px-5 py-3.5 sm:px-8">
    <a href={url('/v3')} class="relative z-50 flex items-center gap-3" aria-label={`${site.name} — home`}>
      <Image src={logo} alt="" width={32} height={32} class="h-8 w-8 object-contain brightness-0 invert" />
      <span class="c-display text-lg tracking-wide">Boyles</span>
    </a>

    <button
      id="c-toggle"
      type="button"
      class="relative z-50 flex h-10 w-10 items-center justify-center"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="c-menu"
    >
      <span class="flex w-6 flex-col gap-[7px]" aria-hidden="true">
        <span class="c-bar h-px w-full bg-cream transition-transform duration-300"></span>
        <span class="c-bar-mid h-px w-full bg-cream transition-opacity duration-200"></span>
        <span class="c-bar h-px w-full bg-cream transition-transform duration-300"></span>
      </span>
    </button>
  </div>

  <div id="c-menu" class="fixed inset-0 z-40 flex-col bg-void xl:hidden">
    <nav class="flex flex-1 flex-col justify-center gap-2 px-6 sm:px-10" aria-label="Mobile">
      {nav.map((item, i) => (
        <a
          href={url(item.href)}
          aria-current={isActive(item.href, pathname) ? 'page' : undefined}
          class="c-display flex items-baseline gap-5 border-b border-edge py-6 text-5xl text-cream aria-[current=page]:text-brass sm:text-6xl"
        >
          <span class="c-kicker !text-ash">0{i + 1}</span>
          {item.label}
        </a>
      ))}
      <div class="mt-10 flex flex-col gap-4">
        <a href={site.phoneHref} class="c-btn c-btn-solid">{site.phone}</a>
        <a href={site.emailHref} class="text-center text-sm text-ash">{site.email}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  #c-toggle[aria-expanded='true'] .c-bar-mid { opacity: 0; }
  #c-toggle[aria-expanded='true'] .c-bar:first-child { transform: translateY(8px) rotate(45deg); }
  #c-toggle[aria-expanded='true'] .c-bar:last-child { transform: translateY(-8px) rotate(-45deg); }
</style>

<script>
  const toggle = document.getElementById('c-toggle')!;
  const menu = document.getElementById('c-menu')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('open', open);
    document.body.classList.toggle('c-locked', open);
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
  });
  window.matchMedia('(min-width: 80rem)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
</script>

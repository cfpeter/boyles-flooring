---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site, nav } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="bg-espresso text-bone/70">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <!-- Identity -->
    <div class="md:col-span-4">
      <div class="flex items-center gap-3">
        <Image src={logo} alt="" width={40} height={40} class="h-10 w-10 object-contain invert" />
        <span class="leading-none">
          <span class="block font-display text-lg text-bone">Boyles</span>
          <span class="block text-[0.6rem] font-bold uppercase tracking-[0.28em] text-oak">Flooring</span>
        </span>
      </div>
      <p class="mt-5 max-w-xs text-sm leading-relaxed">
        Flooring and doors for Santa Clarita — selected, measured and installed
        by a team that does this every day.
      </p>
      <div class="mt-6 flex gap-3">
        <a
          href={site.social.instagram.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-10 w-10 items-center justify-center border border-bone/20 transition-colors hover:border-oak hover:bg-oak hover:text-bone"
          aria-label={`Instagram — ${site.social.instagram.handle}`}
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 5.68a4.16 4.16 0 1 0 0 8.32 4.16 4.16 0 0 0 0-8.32Zm0 6.86a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4Zm5.3-7.02a.97.97 0 1 1-1.94 0 .97.97 0 0 1 1.94 0Z"/>
          </svg>
        </a>
        <a
          href={site.social.tiktok.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-10 w-10 items-center justify-center border border-bone/20 transition-colors hover:border-oak hover:bg-oak hover:text-bone"
          aria-label={`TikTok — ${site.social.tiktok.handle}`}
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 1 1 .77-5.06v-3.1a5.66 5.66 0 0 0-.77-.05A5.68 5.68 0 1 0 15.54 15.4V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.29 4.29 0 0 1-3.24-1.48Z"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Visit -->
    <div class="md:col-span-4">
      <h2 class="text-[0.6875rem] font-bold uppercase tracking-[0.18em] text-oak">Visit the Showroom</h2>
      <address class="mt-5 not-italic text-sm leading-relaxed">
        <a href={site.mapsLink} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-bone">
          {site.address.street}<br />
          {site.address.city}, {site.address.state} {site.address.zip}
        </a>
      </address>
      <dl class="mt-5 space-y-1.5 text-sm">
        {site.hours.map((h) => (
          <div class="flex justify-between gap-4 border-b border-bone/10 pb-1.5">
            <dt>{h.days}</dt>
            <dd class="text-bone/90">{h.time}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Reach us -->
    <div class="md:col-span-4">
      <h2 class="text-[0.6875rem] font-bold uppercase tracking-[0.18em] text-oak">Get in Touch</h2>
      <div class="mt-5 space-y-3 text-sm">
        <a href={site.phoneHref} class="block font-display text-2xl text-bone transition-colors hover:text-oak">
          {site.phone}
        </a>
        <a href={site.emailHref} class="block transition-colors hover:text-bone">{site.email}</a>
      </div>
      <nav class="mt-8 flex flex-col gap-2.5 text-sm" aria-label="Footer">
        {nav.map((item) => (
          <a href={url(item.href)} class="transition-colors hover:text-bone">{item.label}</a>
        ))}
      </nav>
    </div>
  </div>

  <div class="border-t border-bone/10">
    <div class="wrap flex flex-col items-center justify-between gap-2 py-6 text-xs sm:flex-row">
      <p>&copy; {year} {site.name}. All rights reserved.</p>
      <p>Serving {site.address.city} and the greater Santa Clarita Valley.</p>
    </div>
  </div>
</footer>

---
import { Image } from 'astro:assets';
import { categories } from '../../data/content';
import { url } from '../../lib/url';
---

<!-- Editorial index. On pointer devices the preview tracks the cursor;
     on touch the thumbnail sits inline in the row instead. -->
<div id="cat-index" class="relative">
  <ul class="border-t border-line">
    {categories.map((c, i) => (
      <li>
        <a
          href={`${url('/v2/products')}#${c.slug}`}
          class="cat-row group grid grid-cols-[auto_1fr_auto] items-center gap-5 border-b border-line py-6 transition-colors duration-300 hover:bg-ink hover:text-paper md:gap-10 md:py-8"
          data-index={i}
        >
          <span class="v2-tag w-8 transition-colors group-hover:text-accent md:w-12">
            {String(i + 1).padStart(2, '0')}
          </span>

          <span class="min-w-0">
            <span class="v2-display block text-[7vw] leading-[0.95] sm:text-4xl md:text-5xl lg:text-6xl">
              {c.name}
            </span>
            <span class="mt-1.5 block max-w-md text-xs text-mute transition-colors group-hover:text-paper/60 md:mt-2.5 md:text-sm">
              {c.blurb}
            </span>
          </span>

          <span class="flex items-center gap-4">
            <!-- Inline thumbnail: the touch-friendly stand-in for the hover preview -->
            <Image
              src={c.image}
              alt=""
              widths={[160]}
              class="h-14 w-20 shrink-0 object-cover md:hidden"
            />
            <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <!-- Cursor-following preview (desktop only, purely decorative) -->
  <div
    id="cat-preview"
    class="pointer-events-none fixed left-0 top-0 z-30 hidden h-56 w-72 overflow-hidden opacity-0 transition-opacity duration-300 md:block"
    aria-hidden="true"
  >
    {categories.map((c, i) => (
      <Image
        src={c.image}
        alt=""
        widths={[600]}
        data-preview={i}
        class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-200"
      />
    ))}
  </div>
</div>

<script>
  const wrap = document.getElementById('cat-index');
  const preview = document.getElementById('cat-preview');

  // Decoration for mouse users only — never required to read the list.
  if (wrap && preview && window.matchMedia('(min-width: 768px) and (pointer: fine)').matches) {
    const shots = preview.querySelectorAll<HTMLElement>('[data-preview]');
    let x = 0, y = 0, cx = 0, cy = 0, raf = 0, active = false;

    const loop = () => {
      cx += (x - cx) * 0.14;
      cy += (y - cy) * 0.14;
      preview.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      raf = active ? requestAnimationFrame(loop) : 0;
    };

    wrap.querySelectorAll<HTMLElement>('.cat-row').forEach((row) => {
      row.addEventListener('mouseenter', () => {
        const i = row.dataset.index;
        shots.forEach((s) => (s.style.opacity = s.dataset.preview === i ? '1' : '0'));
        preview.style.opacity = '1';
        if (!active) { active = true; loop(); }
      });
      row.addEventListener('mouseleave', () => {
        preview.style.opacity = '0';
        active = false;
      });
    });

    window.addEventListener('mousemove', (e) => {
      // Offset so the panel trails the cursor rather than sitting under it
      x = e.clientX + 28;
      y = e.clientY - 112;
    }, { passive: true });
  }
</script>

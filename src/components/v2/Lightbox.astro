---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { items: { image: ImageMetadata; alt: string }[]; }
const { items } = Astro.props;

const slides = await Promise.all(
  items.map(async (item) => {
    const o = await getImage({ src: item.image, width: 1600, format: 'webp' });
    return { src: o.src, alt: item.alt };
  })
);
---

<div id="v2-lightbox" class="fixed inset-0 z-[70] flex-col bg-ink/97" role="dialog" aria-modal="true" aria-label="Image viewer">
  <div class="flex items-center justify-between px-5 py-4 md:px-8">
    <p id="v2lb-count" class="v2-tag !text-paper/50"></p>
    <button id="v2lb-close" type="button" class="flex h-11 w-11 items-center justify-center text-paper/70 transition-colors hover:text-accent" aria-label="Close viewer">
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div class="relative flex flex-1 items-center justify-center px-4 pb-4 md:px-20">
    <button id="v2lb-prev" type="button" class="absolute left-2 z-10 flex h-12 w-12 items-center justify-center border border-paper/25 text-paper/70 transition-colors hover:bg-paper hover:text-ink md:left-6" aria-label="Previous image">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>

    <img id="v2lb-img" src="" alt="" class="max-h-full max-w-full object-contain" />

    <button id="v2lb-next" type="button" class="absolute right-2 z-10 flex h-12 w-12 items-center justify-center border border-paper/25 text-paper/70 transition-colors hover:bg-paper hover:text-ink md:right-6" aria-label="Next image">
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>

  <p id="v2lb-cap" class="px-6 pb-6 text-center text-sm text-paper/60"></p>
</div>

<style>
  /* Structural show/hide only — never gated on a transition */
  #v2-lightbox { display: none; }
  #v2-lightbox.open { display: flex; }
</style>

<script is:inline define:vars={{ slides }}>
  (function () {
    const box = document.getElementById('v2-lightbox');
    if (!box || !slides.length) return;
    const img = document.getElementById('v2lb-img');
    const cap = document.getElementById('v2lb-cap');
    const count = document.getElementById('v2lb-count');
    const closeB = document.getElementById('v2lb-close');
    const prevB = document.getElementById('v2lb-prev');
    const nextB = document.getElementById('v2lb-next');
    let i = 0, last = null;

    function show(n) {
      i = (n + slides.length) % slides.length;
      img.src = slides[i].src;
      img.alt = slides[i].alt;
      cap.textContent = slides[i].alt;
      count.textContent = `${i + 1} / ${slides.length}`;
    }
    function open(n) { last = document.activeElement; show(n); box.classList.add('open'); document.body.classList.add('v2-locked'); closeB.focus(); }
    function close() { box.classList.remove('open'); document.body.classList.remove('v2-locked'); img.src = ''; if (last) last.focus(); }

    document.querySelectorAll('[data-v2lb]').forEach((b) =>
      b.addEventListener('click', () => open(Number(b.dataset.v2lb)))
    );
    closeB.addEventListener('click', close);
    prevB.addEventListener('click', () => show(i - 1));
    nextB.addEventListener('click', () => show(i + 1));
    box.addEventListener('click', (e) => { if (e.target === box || e.target.id === 'v2lb-cap') close(); });

    document.addEventListener('keydown', (e) => {
      if (!box.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
      if (e.key === 'Tab') {
        const f = [closeB, prevB, nextB];
        const at = f.indexOf(document.activeElement);
        if (at === -1) return;
        e.preventDefault();
        f[((e.shiftKey ? at - 1 : at + 1) + f.length) % f.length].focus();
      }
    });

    let sx = null;
    box.addEventListener('touchstart', (e) => { sx = e.changedTouches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      if (sx === null) return;
      const d = e.changedTouches[0].clientX - sx;
      if (Math.abs(d) > 50) show(d > 0 ? i - 1 : i + 1);
      sx = null;
    }, { passive: true });
  })();
</script>

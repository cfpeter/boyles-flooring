---
interface Props { items: string[]; tone?: 'ink' | 'paper'; }
const { items, tone = 'ink' } = Astro.props;
const doubled = [...items, ...items];
---

<div
  class:list={[
    'v2-marquee border-y py-4',
    tone === 'ink' ? 'border-line bg-fill text-ink' : 'border-paper/15 bg-ink text-paper',
  ]}
  aria-hidden="true"
>
  {[0, 1].map(() => (
    <ul>
      {doubled.map((t) => (
        <li class="v2-display flex items-center gap-12 whitespace-nowrap text-2xl md:text-3xl">
          {t}
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
        </li>
      ))}
    </ul>
  ))}
</div>

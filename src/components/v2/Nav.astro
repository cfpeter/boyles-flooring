---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { site } from '../../data/site';
import { url, isActive } from '../../lib/url';

const nav = [
  { label: 'Index', href: '/v2' },
  { label: 'Materials', href: '/v2/products' },
  { label: 'Contact', href: '/v2/contact' },
];
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/92 backdrop-blur-md">
  <div class="v2-wrap flex items-center justify-between gap-8 py-3.5">
    <a href={url('/v2')} class="relative z-50 flex items-center gap-3" aria-label={`${site.name} — home`}>
      <Image src={logo} alt="" width={36} height={36} loading="eager" class="h-8 w-8 object-contain" />
      <span class="v2-display text-[0.95rem] leading-none tracking-[-0.02em]">Boyles<span class="text-accent">.</span></span>
    </a>

    <nav class="hidden items-center gap-10 lg:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={url(item.href)}
          aria-current={isActive(item.href, pathname) ? 'page' : undefined}
          class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-mute transition-colors hover:text-ink aria-[current=page]:text-accent"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a href={site.phoneHref} class="text-[0.7rem] font-semibold uppercase tracking-[0.16em] transition-colors hover:text-accent">
        {site.phone}
      </a>
      <a href={url('/v2/contact')} class="v2-btn v2-btn-solid !px-5 !py-2.5 !text-[0.65rem]">Get a quote</a>
    </div>

    <button
      id="v2-toggle"
      type="button"
      class="relative z-50 -mr-1 flex h-10 w-10 items-center justify-center lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="v2-menu"
    >
      <span class="flex w-6 flex-col gap-[6px]" aria-hidden="true">
        <span class="v2-bar h-[2px] w-full bg-current transition-transform duration-300"></span>
        <span class="v2-bar-mid h-[2px] w-full bg-current transition-opacity duration-200"></span>
        <span class="v2-bar h-[2px] w-full bg-current transition-transform duration-300"></span>
      </span>
    </button>
  </div>

  <!-- Mobile panel -->
  <div id="v2-menu" class="fixed inset-0 z-40 flex-col bg-ink text-paper lg:hidden">
    <nav class="v2-wrap flex flex-1 flex-col justify-center gap-1" aria-label="Mobile">
      {nav.map((item, i) => (
        <a
          href={url(item.href)}
          aria-current={isActive(item.href, pathname) ? 'page' : undefined}
          class="v2-display border-b border-paper/15 py-6 text-[13vw] leading-none text-paper aria-[current=page]:text-accent sm:text-6xl"
        >
          <span class="mr-4 align-super text-[0.28em] font-semibold tracking-normal text-paper/40">
            0{i + 1}
          </span>
          {item.label}
        </a>
      ))}
      <div class="mt-10 flex flex-col gap-3">
        <a href={site.phoneHref} class="v2-btn v2-btn-invert">{site.phone}</a>
        <a href={site.emailHref} class="text-center text-sm text-paper/60">{site.email}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  #v2-toggle[aria-expanded='true'] { color: var(--color-paper); }
  #v2-toggle[aria-expanded='true'] .v2-bar-mid { opacity: 0; }
  #v2-toggle[aria-expanded='true'] .v2-bar:first-child { transform: translateY(8px) rotate(45deg); }
  #v2-toggle[aria-expanded='true'] .v2-bar:last-child { transform: translateY(-8px) rotate(-45deg); }
</style>

<script>
  const toggle = document.getElementById('v2-toggle')!;
  const menu = document.getElementById('v2-menu')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('open', open);
    document.body.classList.toggle('v2-locked', open);
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Never strand a scroll-locked body if the viewport grows past the breakpoint.
  window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

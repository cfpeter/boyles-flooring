---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slides: { image: ImageMetadata; label: string; alt: string }[];
}
const { slides } = Astro.props;
---

<!-- Image layer. The first slide is marked active server-side and its opacity
     is set outright, so if the cross-fade never runs the hero still shows a
     photograph rather than a blank panel. -->
<div class="hero-slides absolute inset-0" aria-hidden="true">
  {slides.map((s, i) => (
    <Image
      src={s.image}
      alt=""
      widths={[900, 1500, 2100]}
      sizes="100vw"
      loading={i === 0 ? 'eager' : 'lazy'}
      fetchpriority={i === 0 ? 'high' : 'auto'}
      data-slide={i}
      class:list={['hero-slide absolute inset-0 h-full w-full object-cover', i === 0 && 'is-active']}
    />
  ))}
</div>

<!-- Controls sit above the scrim -->
<div class="pointer-events-none absolute inset-x-0 bottom-12 z-20 md:bottom-16">
  <div class="wrap flex items-center justify-between gap-6">
    <p id="hero-label" class="pointer-events-none text-[0.65rem] font-bold uppercase tracking-[0.2em] text-bone/75">
      {slides[0].label}
    </p>

    <div class="pointer-events-auto flex items-center gap-4">
      <ul class="flex items-center gap-2.5" role="tablist" aria-label="Choose a picture">
        {slides.map((s, i) => (
          <li>
            <button
              type="button"
              role="tab"
              data-dot={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={s.label}
              class="hero-dot block h-1.5 w-6 bg-bone/35 transition-[background-color,width] duration-500 aria-selected:w-10 aria-selected:bg-oak"
            ></button>
          </li>
        ))}
      </ul>

      <div class="hidden items-center gap-1.5 sm:flex">
        <button id="hero-prev" type="button" aria-label="Previous picture"
          class="flex h-9 w-9 items-center justify-center border border-bone/30 text-bone/70 transition-colors hover:border-bone hover:text-bone">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button id="hero-next" type="button" aria-label="Next picture"
          class="flex h-9 w-9 items-center justify-center border border-bone/30 text-bone/70 transition-colors hover:border-bone hover:text-bone">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Only the active slide is opaque. Non-active slides fade out rather than
     the active one fading in, so the visible state never depends on a
     transition finishing. */
  .hero-slide { opacity: 0; transition: opacity 1.1s cubic-bezier(0.4, 0, 0.2, 1); }
  .hero-slide.is-active { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide { transition: none; }
    .hero-dot { transition: none; }
  }
</style>

<script>
  const slides = [...document.querySelectorAll<HTMLElement>('.hero-slide')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-dot]')];
  const label = document.getElementById('hero-label');
  const region = document.querySelector<HTMLElement>('.hero-slides')?.parentElement;

  if (slides.length > 1) {
    const labels = dots.map((d) => d.getAttribute('aria-label') || '');
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)');
    let i = 0;
    let timer = 0;

    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('is-active', k === i));
      dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === i)));
      if (label) label.textContent = labels[i];
    };

    const stop = () => { if (timer) { clearInterval(timer); timer = 0; } };
    const start = () => {
      stop();
      if (calm.matches) return;          // no drifting slideshow for reduced motion
      timer = window.setInterval(() => show(i + 1), 5200);
    };

    dots.forEach((d, n) => d.addEventListener('click', () => { show(n); start(); }));
    document.getElementById('hero-prev')?.addEventListener('click', () => { show(i - 1); start(); });
    document.getElementById('hero-next')?.addEventListener('click', () => { show(i + 1); start(); });

    // Pause while someone is looking at or interacting with the hero
    region?.addEventListener('mouseenter', stop);
    region?.addEventListener('mouseleave', start);
    region?.addEventListener('focusin', stop);
    region?.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    calm.addEventListener('change', start);

    start();
  }
</script>

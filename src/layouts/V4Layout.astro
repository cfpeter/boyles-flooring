---
import '../styles/v4.css';
import Nav from '../components/v4/Nav.astro';
import Footer from '../components/v4/Footer.astro';
import { site } from '../data/site';

interface Props { title: string; description?: string; }
const { title, description = site.description } = Astro.props;
const asset = (p: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${p}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site.name} — Design D</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14342B" />
    <link rel="icon" href={asset('/favicon.png')} type="image/png" />
    <meta name="robots" content="noindex, nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=DM+Sans:wght@400;500;600&display=swap"
    />

    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>

  <body>
    <a href="#d-main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-forest focus:px-5 focus:py-3 focus:text-sm focus:text-linen">
      Skip to content
    </a>

    <Nav />
    <main id="d-main"><slot /></main>
    <Footer />

    <!-- Sticky call bar — mobile only, the one place a showroom visit is one tap away -->
    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-forest/10 bg-linen/95 p-3 backdrop-blur lg:hidden">
      <a href={site.phoneHref} class="d-btn d-btn-forest !py-3 !text-sm">Call</a>
      <a href={site.mapsLink} target="_blank" rel="noopener noreferrer" class="d-btn d-btn-outline !py-3 !text-sm">Directions</a>
    </div>
    <div class="h-20 lg:hidden" aria-hidden="true"></div>

    <a
      href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/designs`}
      class="fixed bottom-24 right-4 z-[60] flex items-center gap-2 rounded-full bg-forest px-4 py-2.5 text-xs font-semibold text-linen shadow-lg transition-colors hover:bg-rust lg:bottom-5"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-honey"></span>
      Design D — compare all
    </a>

    <script>
      const els = document.querySelectorAll('.d-in');
      if (els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('on');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -5% 0px', threshold: 0.04 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
